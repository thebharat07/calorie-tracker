# ==============================================================================
# Calorie Tracker Environment Configuration
# Copy this file to .env and customize values for your deployment
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# Option A: Built-in local PostgreSQL container (default in docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# Option B: External Supabase PostgreSQL Database
# If using Supabase, uncomment and fill in your connection details:
# DB_URL=jdbc:postgresql://<project-ref>.pooler.supabase.com:5432/postgres
# DB_USER=postgres.<project-ref>
# DB_PASSWORD=your-database-password

# ------------------------------------------------------------------------------
# 2. Google Gemini Vision API
# ------------------------------------------------------------------------------
# API Key for meal photo nutrition extraction via Gemini 3.8 Flash
# If omitted or empty, backend runs with fallback mock response for testing.
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 3. Application Ports & Network
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=8080
HTTP_PORT=80

# Allowed frontend origins for Spring Boot CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost,http://localhost:80

# Optional public API URL for frontend (leave blank to proxy through Next.js /api)
NEXT_PUBLIC_API_URL=
