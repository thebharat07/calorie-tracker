# Supabase Connection Settings
# Get from Supabase Project Settings -> Database -> Connection string (JDBC)
# Session pooler recommended: jdbc:postgresql://<project-ref>.pooler.supabase.com:5432/postgres
DB_URL=jdbc:postgresql://<host>:5432/postgres
DB_USER=postgres.<project-ref>
DB_PASSWORD=your-database-password

# Google Gemini API Key for Gemini Vision Meal Extraction
GEMINI_API_KEY=your-gemini-api-key

# Optional CORS allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
